<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.EditContactFragment">

    <EditText
        android:id="@+id/edit_contact_name"
        android:autofillHints="@string/fragment_name_subtitle"
        android:hint="@string/fragment_name_subtitle"
        android:inputType="textPersonName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/edit_contact_firstname"
        android:autofillHints="@string/fragment_firstname_subtitle"
        android:hint="@string/fragment_firstname_subtitle"
        android:inputType="textPersonName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_contact_name" />

    <EditText
        android:id="@+id/edit_contact_email"
        android:autofillHints="@string/fragment_email_subtitle"
        android:hint="@string/fragment_email_subtitle"
        android:inputType="textEmailAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_contact_firstname" />

    <EditText
        android:id="@+id/edit_contact_birthday"
        android:autofillHints="@string/fragment_birthday_subtitle"
        android:hint="@string/fragment_birthday_subtitle"
        android:inputType="date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_contact_email" />

    <EditText
        android:id="@+id/edit_contact_address"
        android:autofillHints="@string/fragment_address_subtitle"
        android:hint="@string/fragment_address_subtitle"
        android:inputType="textPostalAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_contact_birthday" />

    <EditText
        android:id="@+id/edit_contact_zip"
        android:autofillHints="@string/fragment_zip_subtitle"
        android:hint="@string/fragment_zip_subtitle"
        android:inputType="number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_contact_address" />

    <EditText
        android:id="@+id/edit_contact_city"
        android:autofillHints="@string/fragment_city_subtitle"
        android:hint="@string/fragment_city_subtitle"
        android:inputType="text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_contact_zip" />

    <TextView
        android:id="@+id/edit_contact_phonetype_title"
        android:text="@string/fragment_phonetype_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_contact_city" />

    <RadioGroup
        android:id="@+id/edit_contact_phonetype"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_contact_phonetype_title" >

        <RadioButton
            android:id="@+id/edit_contact_phonetype_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_phonetype_home" />
        <RadioButton
            android:id="@+id/edit_contact_phonetype_mobile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_phonetype_mobile" />
        <RadioButton
            android:id="@+id/edit_contact_phonetype_office"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_phonetype_office" />
        <RadioButton
            android:id="@+id/edit_contact_phonetype_fax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_phonetype_fax" />
    </RadioGroup>

    <EditText
        android:id="@+id/edit_contact_phonenumber"
        android:autofillHints="@string/fragment_phonenumber_subtitle"
        android:hint="@string/fragment_phonenumber_subtitle"
        android:inputType="phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_contact_phonetype" />

    <Button
        android:id="@+id/button_cancel"
        android:text="@string/fragment_btn_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_contact_phonenumber"
        app:layout_constraintEnd_toStartOf="@id/button_delete" />

    <!-- Buttons Modif/Delete -->
    <Button
        android:id="@+id/button_delete"
        android:text="@string/fragment_btn_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/button_cancel"
        app:layout_constraintTop_toBottomOf="@id/edit_contact_phonenumber"
        app:layout_constraintEnd_toStartOf="@id/button_save" />

    <Button
        android:id="@+id/button_save"
        android:text="@string/fragment_btn_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/button_delete"
        app:layout_constraintTop_toBottomOf="@id/edit_contact_phonenumber"
        app:layout_constraintEnd_toStartOf="@id/button_create" />

    <!-- Button Create -->

    <Button
        android:id="@+id/button_create"
        android:text="@string/fragment_btn_create"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/button_save"
        app:layout_constraintTop_toBottomOf="@id/edit_contact_phonenumber"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>